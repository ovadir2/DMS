# Copy to .env next to this file and fill in. Never commit .env or the certificate.
# Pilot on a PC (Start-DmsPlayground.ps1 -Live): the lines marked [script] are set by the script, a value here is not used.

DMS_REPOSITORY_ROOT=\\FILE-SERVER\Corporate_Data_TEST                              # [script] -Root
DMS_SITE_URL=https://rhisrael.sharepoint.com/sites/DocumentControl-TEST              # [script] -Site
DMS_TENANT_ID=<tenant id>                                                            # [script]
DMS_CHOICE_LANGUAGE=he

# App-only access to SharePoint (Sites.Selected, write on the DocumentControl site) - server install
DMS_CLIENT_ID=<service app id>                                                       # pilot: the Entra app id you use for PnP ($C)
DMS_CERT_PATH=C:\DMS\webapi\cert\dms-webapi.pem
DMS_CERT_THUMBPRINT=<certificate thumbprint>

# Sign-in: windows (the Windows login, AD decides what each user sees - the default)
#          entra (from outside the network) | header (trusted reverse proxy) | dev (testing only)
DMS_AUTH_MODE=windows                                                                # [script] dev
# Super users: see everything (no AD check), all workflows, approve any stage, DMS First loading
DMS_ADMINS=<your.email>@rh.co.il,roneno@rh.co.il
# DMS_API_AUDIENCE=<DMS app registration id>      (entra only)
# DMS_SPA_CLIENT_ID=<DMS app registration id>     (entra only)
# DMS_USER_HEADER=X-MS-CLIENT-PRINCIPAL-NAME
# DMS_DEV_USER=someone@rh.co.il                                                      # [script] your SharePoint sign-in
# Testing only: "Acting as" list on the page (domain account RH\name or email); in the pilot their AD / NTFS access is checked
DMS_DEV_USERS=<RH\domainuser>,<user.email>@rh.co.il
# DMS_DEV_AD_CHECK=1                                                                 # [script] on with -Live (-NoAdCheck: off)

# The RH Navigator origin, when it calls the API from its own pages
DMS_ALLOWED_ORIGINS=https://<navigator server>
DMS_DOCUMENT_ID_PREFIX=DMS
DMS_CUSTOMERS_FOLDER=02_Customers
# Short paths for Open / Copy link: folder under the root = drive letter or share (";" between folders).
# Each PC can have its own letters: scripts\Set-DmsDrives.ps1 -Root <root> -DmsUrl <DMS address>
DMS_SHORT_PATHS=02_Customers=R:;01_General=G:
DMS_MAX_UPLOAD_MB=500
# Folders down to this depth (02_Customers\Customer_A) cannot be renamed or deleted
DMS_PROTECTED_DEPTH=2

# Approvals: page (on the DMS page) | flow (DC-P1 in Teams)                          # [script] -Approvals
# DMS_APPROVALS=page
# Email + Teams notifications through the DMS Notifications list (DC-P2 flow): 1 on, 0 off
DMS_NOTIFY=1
# DMS_PAGE_URL=https://<dms server>/dms/dms-page                                     # [script] links in the notifications
# Delegation of an approval: working days, and the weekend
DMS_DELEGATION_DAYS=3
DMS_WEEKEND=fri,sat
# Workflow file moves inside the service every N seconds (0: the separate Invoke-DmsWorkflowService.ps1)
# DMS_FILE_SERVICE_SECONDS=60                                                        # [script] -FileServiceSeconds

# AI Insights: the RH on-prem AI chat. The DMS posts to <DMS_AI_URL><DMS_AI_PATH> what the chat page sends
# ({"model": "org-chat", "messages": [...]}). A file is uploaded like the page (📎); if that fails, its text is sent.
DMS_AI_URL=https://chat.ai.rh-global.com
DMS_AI_PATH=/stream
DMS_AI_UPLOAD_PATH=/upload
DMS_AI_MODEL=org-chat
# Only if the RH AI ever asks for sign-in: a DMS service token (never a personal one)
DMS_AI_TOKEN=
DMS_AI_MAX_CHARS=60000
# DMS_AI_KNOWLEDGE_IDS=<knowledge id>,<knowledge id>

# File Linker (DMS First loading moves its links to the new Current_ReadOnly paths)
# WebAPI#1 - is a path registered? ({path} is replaced, URL-encoded). A 404 means "not registered".
DMS_FL_CHECK_URL=
# WebAPI#2 - replace a registered path; the body is a JSON template with {old} and {new}
DMS_FL_UPDATE_URL=
DMS_FL_UPDATE_METHOD=POST
DMS_FL_UPDATE_BODY={"oldPath": "{old}", "newPath": "{new}"}
# The JSON field of WebAPI#1 that says "registered" (empty: any 200 with a non-empty answer)
DMS_FL_REGISTERED_FIELD=
# windows (the service's Windows login) | bearer (DMS_FL_TOKEN) | none
DMS_FL_AUTH=windows
DMS_FL_TOKEN=

# AI Insights RAG tools on the RH AI portal (n8n). Each tool is a tab in AI Insights; its questions go to
# <DMS_RAG_URL>/<tool>-chat (e.g. https://aiportal.ai.rh-global.com/webhook/qms-chat). On-prem, no token.
DMS_RAG_URL=https://aiportal.ai.rh-global.com/webhook
DMS_RAG_TOOLS=qms
# Only if the portal ever asks for sign-in: a service account token (never a personal one)
DMS_RAG_TOKEN=

# Sharing with customers: files go to <DMS_EX_LIBRARY>/<DMS_EX_FOLDER>/<Customer> on the Exchange site,
# the customer is invited to that folder. DMS_EX_SHORTCUT adds a OneDrive shortcut DMS_<Customer> for the
# user who shares (Microsoft Graph; the Entra app needs Files.ReadWrite.All, delegated for interactive sign-in).
DMS_EX_SITE_URL=https://rhisrael.sharepoint.com/sites/LargeFileExchange-TEST        # [script] -ExchangeSite
DMS_EX_LIBRARY=TemporaryUploads
DMS_EX_FOLDER=Outbound
# Shared files are removed from the Exchange site N days after their last share (0: never)
DMS_EX_DAYS=30
# Per customer, under 02_Customers\<Customer>: every share is appended (empty: off)
DMS_SHARED_LOG=Shared/DMS-Shared-Log.csv
DMS_EX_SHORTCUT=true
# The OneDrive folder that holds the shortcuts (created if missing; empty: OneDrive root)
DMS_EX_SHORTCUT_FOLDER=DMS Shortcuts

# First loading, mode "DMS approval": recorded as the approver (an M365 user, member of the DocumentControl site)
DMS_FIRST_LOAD_APPROVER=dms_approval@rh.co.il
# During approval the owner and the approvers may edit the submitted file (remarks); false locks it
DMS_SUBMITTED_EDITABLE=true
