# Copy to .env next to this file and fill in. Never commit .env or the certificate.
DMS_REPOSITORY_ROOT=\\FILE-SERVER\Corporate_Data_TEST
DMS_SITE_URL=https://rhisrael.sharepoint.com/sites/DocumentControl-TEST
DMS_TENANT_ID=<tenant id>
DMS_CHOICE_LANGUAGE=he

# App-only access to SharePoint (Sites.Selected, write on the DocumentControl site)
DMS_CLIENT_ID=<service app id>
DMS_CERT_PATH=C:\DMS\webapi\cert\dms-webapi.pem
DMS_CERT_THUMBPRINT=<certificate thumbprint>

# Sign-in: windows (the Windows login, AD decides what each user sees - the default)
#          entra (from outside the network) | header (trusted reverse proxy) | dev (testing only)
DMS_AUTH_MODE=windows
# DMS_API_AUDIENCE=<DMS app registration id>      (entra only)
# DMS_SPA_CLIENT_ID=<DMS app registration id>     (entra only)
# DMS_USER_HEADER=X-MS-CLIENT-PRINCIPAL-NAME
# DMS_DEV_USER=someone@rh.co.il

# The RH Navigator origin, when it calls the API from its own pages
DMS_ALLOWED_ORIGINS=https://<navigator server>
DMS_DOCUMENT_ID_PREFIX=DMS
DMS_CUSTOMERS_FOLDER=02_Customers
DMS_MAX_UPLOAD_MB=500
# Folders down to this depth (02_Customers\Customer_A) cannot be renamed or deleted
DMS_PROTECTED_DEPTH=2
