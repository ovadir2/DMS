<?xml version="1.0" encoding="utf-8"?>
<!-- IIS site for the DMS Web API (HttpPlatformHandler starts uvicorn). Adjust the paths.
     Windows Authentication ON, Anonymous OFF: users are signed in with their Windows login and
     forwardWindowsAuthToken passes their token, so the API checks the AD (NTFS) permissions. -->
<configuration>
  <system.webServer>
    <!-- IIS's own WebDAV must not answer: the DMS does (Word / Excel open and save files through the DMS link) -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\DMS\webapi\.venv\Scripts\python.exe"
                  arguments="-m uvicorn dms_api.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true" stdoutLogFile="C:\DMS\webapi\logs\uvicorn.log"
                  startupTimeLimit="60" processesPerApplication="1"
                  forwardWindowsAuthToken="true">
      <environmentVariables>
        <environmentVariable name="PYTHONUTF8" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
  </system.webServer>
  <!-- The key endpoints a page served into a sandbox uses. Such a page has an origin of its own, so it
       cannot send the person's Windows sign-in, and IIS would refuse it before the DMS ever saw it. These
       two answer by the key in the address instead: one folder, reading only, for a few hours, in the name
       of the person who opened the page, whose AD rights are checked again on every call.
       The section must be unlocked once on the server: scripts\Set-DmsKpiKeyAccess.ps1 does it. -->
  <location path="api/kpi">
    <system.webServer>
      <security>
        <authentication>
          <anonymousAuthentication enabled="true" />
          <windowsAuthentication enabled="false" />
        </authentication>
      </security>
    </system.webServer>
  </location>
</configuration>
