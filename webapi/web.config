<?xml version="1.0" encoding="utf-8"?>
<!-- IIS site for the DMS Web API (HttpPlatformHandler starts uvicorn). Adjust the two paths. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\DMS\webapi\.venv\Scripts\python.exe"
                  arguments="-m uvicorn dms_api.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true" stdoutLogFile="C:\DMS\webapi\logs\uvicorn.log"
                  startupTimeLimit="60" processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PYTHONUTF8" value="1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
