# RH DMS - .env for the pilot on your PC (Start-DmsPlayground.ps1 -Live)
# Copy to C:\dms\webapi\.env and replace the <placeholders>. Restart the DMS after a change.
# Lines starting with # are off. Never put passwords or personal tokens here.

# --- People --------------------------------------------------------------------------------
# Super users: see everything (no AD check), First loading, SharePoint check, all workflows
DMS_ADMINS=<your.email>@rh.co.il,<second.admin>@rh.co.il
# "Acting as" list on the page (testing): their AD / NTFS access is checked in the pilot
DMS_DEV_USERS=<RH\domainuser>,<user.email>@rh.co.il

# --- Folders -------------------------------------------------------------------------------
DMS_CUSTOMERS_FOLDER=02_Customers
# Short paths for Open / Copy link (drive letters from scripts\Set-DmsDrives.ps1, or shares)
DMS_SHORT_PATHS=02_Customers=R:;01_General=G:
DMS_MAX_UPLOAD_MB=500
DMS_PROTECTED_DEPTH=2

# --- Workflow --------------------------------------------------------------------------------
DMS_DOCUMENT_ID_PREFIX=DMS
DMS_CHOICE_LANGUAGE=he
# Owner and approvers may open the file in Submitted to add remarks
DMS_SUBMITTED_EDITABLE=true
# First loading, mode "DMS approval (simulated)": the approver recorded
DMS_FIRST_LOAD_APPROVER=dms_approval@rh.co.il
# Delegation: working days, and the weekend
DMS_DELEGATION_DAYS=3
DMS_WEEKEND=fri,sat
# Email + Teams notifications through the DMS Notifications list (DC-P2 flow): 1 on, 0 off
DMS_NOTIFY=1

# --- Sharing with customers (Large File Exchange) --------------------------------------------
DMS_EX_LIBRARY=TemporaryUploads
DMS_EX_FOLDER=Outbound
DMS_EX_DAYS=30
DMS_SHARED_LOG=Shared/DMS-Shared-Log.csv
DMS_EX_SHORTCUT=true
DMS_EX_SHORTCUT_FOLDER=DMS Shortcuts

# --- File Linker (First loading moves the links) ----------------------------------------------
# DMS_FL_CHECK_URL=<https://filelinker.rh.local/api/check?path={path}>
# DMS_FL_UPDATE_URL=<https://filelinker.rh.local/api/replace>
# DMS_FL_UPDATE_METHOD=POST
# DMS_FL_UPDATE_BODY={"oldPath":"{old}","newPath":"{new}"}
# DMS_FL_REGISTERED_FIELD=<field in the check answer, e.g. registered>
# DMS_FL_AUTH=windows

# --- AI Insights (RH on-prem) ------------------------------------------------------------------
DMS_AI_URL=https://chat.ai.rh-global.com
DMS_AI_MODEL=org-chat
DMS_RAG_URL=https://aiportal.ai.rh-global.com/webhook
DMS_RAG_TOOLS=qms
# DMS_AI_KNOWLEDGE_IDS=<knowledge id>,<knowledge id>

# --- Set by Start-DmsPlayground.ps1 (a value here is not used when you start with the script) --
# DMS_REPOSITORY_ROOT      -Root
# DMS_AUTH_MODE            dev
# DMS_DEV_USER             your SharePoint sign-in (or -User)
# DMS_SHAREPOINT / DMS_SP_AUTH / DMS_SITE_URL / DMS_EX_SITE_URL / DMS_TENANT_ID / DMS_CLIENT_ID   -Live -ClientId -Site -ExchangeSite
# DMS_APPROVALS            -Approvals (page)
# DMS_FILE_SERVICE_SECONDS -FileServiceSeconds (60)
# DMS_PAGE_URL             http://localhost:<Port>/dms/dms-page
# DMS_DEV_AD_CHECK         on with -Live (-NoAdCheck turns it off)
